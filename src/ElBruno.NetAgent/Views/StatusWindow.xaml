<Window x:Class="ElBruno.NetAgent.Views.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Status" Height="350" Width="400">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical" Grid.Row="0">
            <TextBlock Text="Current Interface:" FontWeight="Bold" />
            <TextBlock Text="{Binding CurrentInterface}" Margin="0,0,0,8" />
            <TextBlock Text="Latency (avg):" FontWeight="Bold" />
            <TextBlock Text="{Binding LatencyAverage}" Margin="0,0,0,8" />
            <TextBlock Text="Quality score:" FontWeight="Bold" />
            <TextBlock Text="{Binding QualityScore}" Margin="0,0,0,8" />
            <TextBlock Text="Auto Mode:" FontWeight="Bold" />
            <TextBlock Text="{Binding AutoMode}" Margin="0,0,0,8" />
            <TextBlock Text="Last Decision:" FontWeight="Bold" />
            <TextBlock Text="{Binding LastDecision}" Margin="0,0,0,8" />
            <TextBlock Text="Last Switch:" FontWeight="Bold" />
            <TextBlock Text="{Binding LastSwitchTimestamp}" Margin="0,0,0,8" />
        </StackPanel>

        <GroupBox Header="Detected Interfaces" Grid.Row="1" Margin="0,8,0,8">
            <ListBox ItemsSource="{Binding DetectedInterfaces}"/>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" MinWidth="80" />
            <Button Content="Restore Metrics" Command="{Binding RestoreMetricsCommand}" MinWidth="120" />
            <Button Content="Open Logs" Command="{Binding OpenLogsCommand}" MinWidth="80" />
            <Button Content="Open Config" Command="{Binding OpenConfigCommand}" MinWidth="100" />
        </StackPanel>
    </Grid>
</Window>
