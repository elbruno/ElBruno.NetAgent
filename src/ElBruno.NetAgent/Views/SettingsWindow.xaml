<Window x:Class="ElBruno.NetAgent.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" MinHeight="420" MinWidth="640">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Notice -->
        <Border BorderBrush="Orange" BorderThickness="1" Background="#FFFFF0" Padding="8" CornerRadius="4">
            <TextBlock Text="Dry-run only: no changes to Windows network settings will be performed." FontWeight="Bold" Foreground="DarkRed" />
        </Border>

        <!-- Main form -->
        <ScrollViewer Grid.Row="1" Margin="0,8,0,8">
            <StackPanel Orientation="Vertical" VerticalAlignment="Top" >
                <!-- General -->
                <GroupBox Header="General" Margin="0,0,0,8">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Content="Dry run mode (no network changes)" IsChecked="{Binding DryRunMode}" />
                        <CheckBox Grid.Row="1" Grid.Column="0" Content="Auto mode enabled" IsChecked="{Binding AutoModeEnabled}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Auto interval (sec):" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Width="80" Text="{Binding AutoModeIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Pause auto-switch duration (sec):" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Width="80" Text="{Binding PauseAutoSwitchDurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                    </Grid>
                </GroupBox>

                <!-- Switching rules -->
                <GroupBox Header="Switching rules" Margin="0,0,0,8">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <TextBlock Text="Minimum quality score required:" VerticalAlignment="Center" Width="220" />
                            <TextBox Width="80" Text="{Binding MinimumQualityScoreRequired, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text=" (0-100)" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Minimum score improvement required:" VerticalAlignment="Center" Width="220" />
                            <TextBox Width="80" Text="{Binding MinimumScoreImprovementRequired, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,6,0,0">
                            <TextBlock Text="Preferred interface patterns (comma separated):" />
                            <TextBox Text="{Binding PreferredInterfacePatternsText}" AcceptsReturn="True" Height="60" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,6,0,0">
                            <TextBlock Text="Excluded interface patterns (comma separated):" />
                            <TextBox Text="{Binding ExcludedInterfacePatternsText}" AcceptsReturn="True" Height="60" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,6,0,0">
                            <TextBlock Text="Excluded interface kinds:" FontWeight="Bold" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox Content="Virtual" IsChecked="{Binding IgnoreVirtualAdapters}" Margin="0,0,8,0" />
                                <CheckBox Content="Loopback" IsChecked="{Binding IgnoreLoopbackAdapters}" Margin="0,0,8,0" />
                                <CheckBox Content="VPN" IsChecked="{Binding IgnoreVpnAdapters}" Margin="0,0,8,0" />
                                <CheckBox Content="Unknown/Down" IsChecked="{Binding IgnoreDownOrUnknown}" />
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                </GroupBox>

                <!-- Actions/Behavior -->
                <GroupBox Header="Actions" Margin="0,0,0,8">
                    <StackPanel Margin="6" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox Content="Prefer USB tethering" IsChecked="{Binding PreferUsbTethering}" Margin="0,0,12,0" />
                            <CheckBox Content="Allow WiFi" IsChecked="{Binding AllowWifi}" Margin="0,0,12,0" />
                            <CheckBox Content="Allow Ethernet" IsChecked="{Binding AllowEthernet}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Read-only paths -->
                <GroupBox Header="Files" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Config file:" Width="120" />
                            <TextBlock Text="{Binding ConfigFilePath}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="App data folder:" Width="120" />
                            <TextBlock Text="{Binding AppDataFolder}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" >
            <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="80" Margin="4" />
            <Button Content="Reload" Command="{Binding ReloadCommand}" MinWidth="80" Margin="4" />
            <Button Content="Reset to defaults" Command="{Binding ResetCommand}" MinWidth="120" Margin="4" />
            <Button Content="Open App Data" Command="{Binding OpenAppDataCommand}" MinWidth="110" Margin="4" />
            <Button Content="Open Config" Command="{Binding OpenConfigCommand}" MinWidth="100" Margin="4" />
            <Button Content="Close" Click="Close_Click" MinWidth="80" Margin="4" />
        </StackPanel>
    </Grid>
</Window>

